<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
	<!-- Private favorite notes and account-scoped notification watermarks must
	     stay on this installation rather than entering cloud backup. -->
	<exclude domain="root" path="favorite-notes.data" />
	<exclude domain="root" path="favorite-notes.data.tmp" />
	<exclude domain="sharedpref" path="notification_preferences.xml" />
	<exclude domain="root" path="direct-media-cache-v1/" />
	<exclude domain="root" path="album-cache-v1/" />
	<exclude domain="root" path="short-video-cache/" />
	<exclude domain="root" path="saved-phrases.data" />
	<exclude domain="root" path="saved-phrases.data.tmp" />
	<exclude domain="file" path="direct-media-cache-v1/" />
	<exclude domain="file" path="album-cache-v1/" />
	<exclude domain="file" path="short-video-cache/" />
	<exclude domain="file" path="saved-phrases.data" />
	<exclude domain="file" path="saved-phrases.data.tmp" />
</full-backup-content>
