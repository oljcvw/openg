{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Open Grind",
	"version": "0.1.0",
	"identifier": "org.opengrind",
	"build": {
		"beforeDevCommand": "bun run dev:web",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [
			{
				"title": "Open Grind",
				"width": 1000,
				"height": 800,
				"minWidth": 320,
				"minHeight": 300,
				"userAgent": "OpenGrind/0.1.0 (+https://opengrind.org/; contact: legal@hloth.dev)",
				"titleBarStyle": "Visible",
				"backgroundColor": "#1e1e1e"
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost https://cdns.grindr.com https://media*.giphy.com data: blob:; font-src 'self' data:; connect-src 'self' ipc: https://*.grindr.com wss://*.grindr.com"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"macOS": {
			"signingIdentity": null,
			"hardenedRuntime": true,
			"entitlements": "Entitlements.plist",
			"infoPlist": "Info.plist",
			"minimumSystemVersion": "12.0"
		}
	}
}
