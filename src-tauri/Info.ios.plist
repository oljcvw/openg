<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>OpenGrindAgoraAppId</key>
	<string>$(OPEN_GRIND_AGORA_APP_ID)</string>
	<key>NSCameraUsageDescription</key>
	<string>Open Grind uses the camera when you choose to take a profile or chat photo, record a short video, or join a video call.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Open Grind uses the microphone when you choose to record a voice message or join a video call.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Open Grind uses your location only when you choose to set or refresh your profile location.</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>doctor.andrewcox.opengrind.background-refresh</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>UIApplicationSceneManifest</key>
  <dict>
    <key>UIApplicationSupportsMultipleScenes</key>
    <true/>
    <key>UISceneConfigurations</key>
    <dict/>
  </dict>
</dict>
</plist>
